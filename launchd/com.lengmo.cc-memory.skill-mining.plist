<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lengmo.cc-memory.skill-mining</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/lengmo/bin/python3</string>
        <string>/Users/lengmo/Desktop/cc-memory/memory/scripts/skill_mining_report.py</string>
        <string>--days</string>
        <string>7</string>
    </array>

    <key>StartCalendarInterval</key>
