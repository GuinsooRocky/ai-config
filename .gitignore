# 白名单模式：默认忽略一切，只放行可复用配置 + memory + 消毒过的机器态配置
# 真正排除不掉的只有：history.jsonl / sessions / session-env（未经审查的原始对话）、
# telemetry / cache / stats-cache.json（纯运行时数据）
/*

!/.gitignore
!/README.md
!/agents/
!/skills/
!/commands/
!/hooks/
!/workflows/
!/design-spec/
!/CLAUDE.md
!/RTK.md
!/model-dispatch.md
!/judgment-rubrics.md
!/delegation-templates.md
!/harness-maintenance.md
!/CLAUDE.md.proposed.md
!/settings.json
!/statusline-command.sh
!/mcp-servers.json
!/launchd/
!/codex/
!/ai-config.json
!/profiles/
!/scripts/

# memory 单独放行（projects/ 下其余都是原始会话 jsonl，不放行）
!/projects/
/projects/*
!/projects/-Users-lengmo/
/projects/-Users-lengmo/*
!/projects/-Users-lengmo/memory/

# firecrawl 是指向 ~/.agents 的外部符号链接（官方安装器管理，新机器重装即得），不入库
/skills/firecrawl

# 各目录内部的派生垃圾
__pycache__/
*.pyc
*.bak
.DS_Store
